# =============================================
# COPILOT BOT — Environment Variables
# =============================================

# === Wallet (add ONLY when ready for live trading) ===
# WALLET_PUBLIC_KEY=your_phantom_wallet_public_key_here
# WALLET_PRIVATE_KEY=your_private_key_here  ← NEVER share this

# === Live Trading Unlock (ALL must be set to enable live) ===
# ENABLE_LIVE_TRADING=TRUE
# WALLET_APPROVED_LIVE_TRADING=TRUE

# === Optional Tuning ===
# ETH_PRICE_TIMEOUT_SECONDS=5
# PORT=5000
